# Defaults for `npm test` on a dev machine (local Postgres, see README). CI/previews override via real env vars.
# No secrets here – local-only credentials.
DATABASE_URL="postgresql://doodle:doodle@localhost:5432/doodle_test?schema=public"
DIRECT_URL="postgresql://doodle:doodle@localhost:5432/doodle_test?schema=public"

# Test/dev: the test client acts as one trusted proxy that sets X-Forwarded-For (see docs/OWNER.md › Client IP)
TRUSTED_PROXY_HOPS=1
