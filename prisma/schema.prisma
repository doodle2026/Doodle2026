generator client {
  provider      = "prisma-client-js"
  // CI builds on Ubuntu (debian-openssl-3.0.x); Vercel functions run on Amazon Linux (rhel-openssl-3.0.x).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supabase transaction pooler) – runtime
  directUrl = env("DIRECT_URL") // direct – migrations
}

model Event {
  id              Int              @id @default(autoincrement())
  slug            String           @unique @db.VarChar(22)
  title           String
  description     String           @default("")
  /// SHA-256 (hex) of the organizer's 256-bit admin token. The raw token is never stored.
  adminTokenHash  String           @map("admin_token_hash") @db.Char(64)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when the organizer closes the poll; isClosed = closedAt != null.
  closedAt        DateTime?        @map("closed_at") @db.Timestamptz(3)
  /// Final time chosen by the organizer when closing (optional). Reset on reopen.
  chosenOptionId  Int?             @unique @map("chosen_option_id")
  /// iCalendar SEQUENCE: bumped whenever the chosen time changes (pick/change/clear or the chosen option is moved).
  icsSequence     Int              @default(0) @map("ics_sequence")
  /// iCalendar LAST-MODIFIED of the chosen time.
  chosenChangedAt DateTime?        @map("chosen_changed_at") @db.Timestamptz(3)
  chosenOption    TimeOption?      @relation("ChosenOption", fields: [chosenOptionId], references: [id], onDelete: SetNull)
  timeOptions     TimeOption[]
  idempotencyKeys IdempotencyKey[]
  participants    Participant[]
  invitations     Invitation[]
  /// Organizer display name for invitation mails ("<name> via GrabAday"), sanitized. Optional.
  organizerName   String?          @map("organizer_name") @db.VarChar(100)
  /// Manual reminders: count (max 3) and last send (max one per 24 h).
  remindersSent   Int              @default(0) @map("reminders_sent")
  lastReminderAt  DateTime?        @map("last_reminder_at") @db.Timestamptz(3)
  /// Set after repeated abuse reports: no more invitation/reminder mails for this poll.
  mailBlockedAt   DateTime?        @map("mail_blocked_at") @db.Timestamptz(3)
  /// Step 5: personal invite links were used for this poll ("Spor hvem der har svaret"). Never switched off again.
  inviteTracking  Boolean          @default(false) @map("invite_tracking")

  @@map("events")
}

model TimeOption {
  id       Int       @id @default(autoincrement())
  eventId  Int       @map("event_id")
  /// Calendar date (no time zone): every option is a whole day.
  date     DateTime  @db.Date
  position Int
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes    Vote[]
  chosenBy Event?    @relation("ChosenOption")

  @@unique([eventId, date])
  @@index([eventId])
  @@map("time_options")
}

/// Idempotency-Key replay store. The key itself is stored only as SHA-256 (hex); the admin token is
/// stored AES-256-GCM-encrypted with a key derived (HKDF) from the raw Idempotency-Key, so only the
/// client that holds the key can recover it on replay. A DB dump reveals neither keys nor tokens.
model IdempotencyKey {
  keyHash       String   @id @map("key_hash") @db.Char(64)
  eventId       Int      @map("event_id")
  adminTokenEnc String   @map("admin_token_enc")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("idempotency_keys")
}

/// Feature 3 (voting) – schema only, no API/UI yet.
model Participant {
  id              Int                  @id @default(autoincrement())
  eventId         Int                  @map("event_id")
  name            String
  /// Case-insensitive uniqueness key: NFKC + trim + lower-case (see participantNameKey()).
  nameKey         String               @map("name_key")
  /// SHA-256 (hex) of the participant's secret edit token (256-bit random → safe to look up by hash).
  editTokenHash   String               @unique @map("edit_token_hash") @db.Char(64)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes           Vote[]
  idempotencyKeys VoteIdempotencyKey[]
  invitation      Invitation?

  @@unique([eventId, nameKey])
  @@index([eventId])
  @@map("participants")
}

/// Idempotent vote submit: sha256(Idempotency-Key) → participant; edit token AES-GCM-sealed under the raw key.
model VoteIdempotencyKey {
  keyHash       String      @id @map("key_hash") @db.Char(64)
  participantId Int         @map("participant_id")
  editTokenEnc  String      @map("edit_token_enc")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("vote_idempotency_keys")
}

enum VoteValue {
  yes
  maybe
  no

  @@map("vote_value")
}

model Vote {
  participantId Int         @map("participant_id")
  timeOptionId  Int         @map("time_option_id")
  value         VoteValue
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  timeOption    TimeOption  @relation(fields: [timeOptionId], references: [id], onDelete: Cascade)

  @@id([participantId, timeOptionId])
  @@index([timeOptionId])
  @@map("votes")
}

/// Invitation mail recipient (step 4). Addresses are deleted with the poll (cascade) or 90 days after close (cron).
model Invitation {
  id              Int          @id @default(autoincrement())
  eventId         Int          @map("event_id")
  /// Normalized (trimmed, lower-case) address.
  email           String       @db.VarChar(320)
  name            String?      @db.VarChar(100)
  /// queued | sent | delivered | failed | bounced | unsub
  delivery        String       @default("queued") @db.VarChar(16)
  reason          String?      @db.VarChar(200)
  /// Resend email id of the latest mail (webhook correlation).
  providerId      String?      @unique @map("provider_id") @db.VarChar(64)
  /// SHA-256 of the per-recipient footer token (unsubscribe this poll / all, report abuse). Raw token only in the mail.
  linkTokenHash   String       @unique @map("link_token_hash") @db.Char(64)
  lastEventAt     DateTime     @default(now()) @map("last_event_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Step 5 personal link: token = HMAC(EMAIL_LINK_SECRET, id + generation); null = public link only.
  /// Resend/revoke bump the generation (old link stops working). Only SHA-256(token) is stored for lookup.
  inviteGen       Int?         @map("invite_gen")
  inviteTokenHash String?      @unique @map("invite_token_hash") @db.Char(64)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  /// Participant who answered via this invitation (or linked manually by the organizer).
  participantId   Int?         @unique @map("participant_id")
  linkedManually  Boolean      @default(false) @map("linked_manually")
  participant     Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("invitations")
}

/// Suppression list: SHA-256 of the normalized address only. scope "all" (any mail) or "poll:<eventId>".
model EmailSuppression {
  emailHash String   @map("email_hash") @db.Char(64)
  scope     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([emailHash, scope])
  @@map("email_suppressions")
}

/// Global send quota per UTC day (Resend Free: 100/day, 3000/month). Reserved atomically before sending.
model EmailQuota {
  day   String @id @db.Char(10)
  count Int    @default(0)

  @@map("email_quota")
}

model AbuseReport {
  id        Int      @id @default(autoincrement())
  eventId   Int?     @map("event_id")
  reason    String   @db.VarChar(32)
  details   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([eventId])
  @@map("abuse_reports")
}
