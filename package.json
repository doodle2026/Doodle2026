{
  "name": "grabaday",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/i18n-check.mjs && next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "start:capture": "NODE_ENV=test node scripts/capture-server.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "intl-messageformat": "^12.1.3",
    "mustache": "^4.2.0",
    "next": "^15.5.27",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "playwright-core": "^1.64.0",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
