# Supabase project in eu-central-1 (Frankfurt). Dashboard → Connect.
# Use a dedicated `prisma` DB role (see README); pooler username is `prisma.<PROJECT_REF>`.
# Runtime (Vercel serverless): Supavisor TRANSACTION pooler, port 6543
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Supavisor SESSION pooler, port 5432 (or direct db.PROJECT_REF.supabase.co:5432 if IPv6/IPv4 add-on)
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Local dev: docker run -p 5432:5432 -e POSTGRES_PASSWORD=doodle postgres:16  (or `supabase start`)
#   DATABASE_URL=DIRECT_URL="postgresql://postgres:doodle@localhost:5432/postgres"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""          # openssl rand -base64 32
RESEND_API_KEY=""           # later: transactional e-mail (Resend, EU region)
EMAIL_FROM="Mødetid <noreply@example.com>"
