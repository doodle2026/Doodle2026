# Supabase project in eu-central-1 (Frankfurt). Dashboard → Connect.
# Use a dedicated `prisma` DB role (see docs/README-DEPLOY.md); pooler username is `prisma.<PROJECT_REF>`.
# Runtime (Vercel serverless): Supavisor TRANSACTION pooler, port 6543
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Supavisor SESSION pooler, port 5432
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Local dev (see README "Lokal Postgres"): both URLs = postgresql://doodle@localhost:5432/doodle_dev?schema=public
# Public base URL (absolute links, OG tags). Production: https://<your-domain>
APP_URL="http://localhost:3000"
# E-mail (Resend). EMAIL_MODE=log (default) only logs a redacted summary; "send" needs RESEND_API_KEY + EMAIL_FROM.
EMAIL_MODE="log"
EMAIL_FROM="Mødetid <noreply@example.com>"
# EMAIL_REPLY_TO=""
# RESEND_API_KEY=""   # production only (secret)
