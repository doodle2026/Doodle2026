# Supabase project in eu-central-1 (Frankfurt). Dashboard → Connect.
# Use a dedicated `prisma` DB role (see docs/README-DEPLOY.md); pooler username is `prisma.<PROJECT_REF>`.
# Runtime (Vercel serverless): Supavisor TRANSACTION pooler, port 6543
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Supavisor SESSION pooler, port 5432
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Local dev (see README "Lokal Postgres"): both URLs = postgresql://doodle@localhost:5432/doodle_dev?schema=public
# Public base URL (absolute links, OG tags). Production: https://<your-domain>
APP_URL="http://localhost:3000"
# E-mail notifications (Resend). See docs/README-DEPLOY.md "E-mail (Resend)".
# EMAIL_MODE: "log" = don't send, log a redacted summary (default for local + previews); "send" = send via Resend (production only).
EMAIL_MODE="log"
# Production only, Vercel env type Sensitive. Not needed when EMAIL_MODE=log.
RESEND_API_KEY=""
# Sender on the verified Resend subdomain
EMAIL_FROM="GrabAday <noreply@mail.example.dk>"
# Optional: where replies go (e.g. your own mailbox)
EMAIL_REPLY_TO=""
# Invitations (step 4)
# Signs the per-recipient unsubscribe/report-abuse links (≥ 32 random chars, e.g. `openssl rand -base64 48`). Required in send mode.
EMAIL_LINK_SECRET=""
# Resend → Webhooks → signing secret (whsec_…) for POST /api/webhooks/resend (events: sent, delivered, delivery_delayed, bounced, complained, failed)
RESEND_WEBHOOK_SECRET=""
# Optional pepper for the hashed suppression list (set once, never change – changing it forgets all unsubscribes)
EMAIL_HASH_PEPPER=""
# Global quota (Resend Free: 100/day, 3000/month); per-poll cap per hour; per-IP sends per hour
EMAIL_DAILY_QUOTA=100
EMAIL_MONTHLY_QUOTA=3000
EMAIL_POLL_HOURLY_MAX=100
RATE_LIMIT_MAIL_PER_HOUR=10
# Bearer secret for GET/POST /api/cron/cleanup (Vercel cron sends it automatically when set in the project env)
CRON_SECRET=""
